<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application>
        <!-- MedLink (the RileyLink activities moved to Compose upstream) -->
        <activity
            android:name="app.aaps.pump.common.dialog.MedLinkBLEConfigActivity"
            android:theme="@style/AppTheme"
            android:exported="false">

            <intent-filter>
                <action android:name="info.nightscout.androidaps.plugins.PumpCommon.dialog.MedLinkBLEScanActivity" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="app.aaps.pump.common.hw.medlink.dialog.MedLinkStatusActivity"
            android:label="@string/title_activity_medlink_settings"/>
    </application>

</manifest>
